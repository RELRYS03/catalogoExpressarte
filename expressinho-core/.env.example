# Arquivo privado: copie este modelo para expressinho-core/.env.
# Nunca coloque chaves em config.js, app.js ou no navegador.
# Ordem de prioridade: NVIDIA NIM -> OpenAI -> Ollama local.

# NVIDIA NIM (principal, se preenchido)
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=COLE_SUA_CHAVE_NVIDIA_AQUI
NVIDIA_API_MODEL=meta/llama-3.1-70b-instruct

# OpenAI (segunda opção online)
EXPRESSINHO_ONLINE_ENABLED=true
EXPRESSINHO_API_BASE_URL=https://api.openai.com/v1
EXPRESSINHO_API_KEY=COLE_SUA_CHAVE_OPENAI_AQUI
EXPRESSINHO_API_MODEL=gpt-4.1-mini

# Ollama (alternativa local; precisa estar instalado, aberto e com modelo de conversa)
OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=nome-do-modelo

# Cache local em memória
EXPRESSINHO_CACHE_TTL_MS=300000
EXPRESSINHO_CACHE_MAX_ENTRIES=100
