# Arquivo privado: copie este modelo para expressinho-core/.env.
# A chave fica somente no servidor local. NUNCA coloque a chave em config.js, app.js ou no navegador.
# Para usar OpenAI como inteligência principal, preencha os 3 campos abaixo.
EXPRESSINHO_ONLINE_ENABLED=true
EXPRESSINHO_API_BASE_URL=https://api.openai.com/v1
EXPRESSINHO_API_KEY=COLE_SUA_CHAVE_AQUI
EXPRESSINHO_API_MODEL=gpt-6-luna

# Ollama é opcional e será usado como alternativa se a API estiver indisponível.
OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=nome-do-modelo

# Cache local em memória
EXPRESSINHO_CACHE_TTL_MS=300000
EXPRESSINHO_CACHE_MAX_ENTRIES=100
