# Copie para expressinho-core/.env e preencha somente no computador/servidor.
Inicie com Node.js 20.6+ usando: node --env-file=expressinho-core/.env expressinho-core/server.mjs
# Nunca publique chaves neste arquivo nem no JavaScript do site.
OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=nome-do-modelo

# Provedor OpenAI-compatible opcional. Desativado por padrão.
EXPRESSINHO_ONLINE_ENABLED=false
# EXPRESSINHO_API_BASE_URL=https://api.exemplo.com/v1
# EXPRESSINHO_API_KEY=
# EXPRESSINHO_API_MODEL=

# Cache local em memória
EXPRESSINHO_CACHE_TTL_MS=300000
EXPRESSINHO_CACHE_MAX_ENTRIES=100
