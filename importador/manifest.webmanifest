{
  "id": "./",
  "name": "Express'Arte Importador",
  "short_name": "Express'Arte",
  "description": "Envie modelos compartilhados para a fila privada do catálogo Express'Arte.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fbf3e8",
  "theme_color": "#4a2b1c",
  "icons": [
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "images", "accept": ["image/*"] }
      ]
    }
  }
}
